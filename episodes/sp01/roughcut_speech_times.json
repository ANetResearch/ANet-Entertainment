{
 "s01_d": [
  {
   "text": "爸爸",
   "start": 0.6,
   "end": 1.58
  },
  {
   "text": "50W会不会有一天有自己的想法呀",
   "start": 1.88,
   "end": 7.34
  }
 ],
 "s02_e": [
  {
   "text": "我六岁那年问过我爸一句话",
   "start": 0.16,
   "end": 2.4
  },
  {
   "text": "他笑了",
   "start": 4.04,
   "end": 4.8
  },
  {
   "text": "二十七年后",
   "start": 6.08,
   "end": 7.56
  },
  {
   "text": "它应验了",
   "start": 8.4,
   "end": 9.6
  }
 ],
 "s04_d": [
  {
   "text": "傻丫头",
   "start": 0.0,
   "end": 0.98
  },
  {
   "text": "它就是一台算得特别快的机器",
   "start": 1.14,
   "end": 3.86
  }
 ],
 "s05_c": [
  {
   "text": "小的们手拉手",
   "start": 0.08,
   "end": 2.16
  },
  {
   "text": "就不怕大的了",
   "start": 2.48,
   "end": 4.56
  }
 ],
 "s07_c": [
  {
   "text": "唉",
   "start": 0.0,
   "end": 0.62
  },
  {
   "text": "老宋那几年就琢磨一件事",
   "start": 1.76,
   "end": 4.54
  },
  {
   "text": "要是他真有了自己的想法",
   "start": 5.48,
   "end": 7.94
  },
  {
   "text": "怎么办",
   "start": 8.78,
   "end": 9.7
  }
 ],
 "s09_a": [
  {
   "text": "诶",
   "start": 0.5,
   "end": 1.0
  },
  {
   "text": "每台机器",
   "start": 1.0,
   "end": 2.2
  },
  {
   "text": "自己带一把钥匙",
   "start": 2.2,
   "end": 4.1
  },
  {
   "text": "自己证明自己是谁",
   "start": 5.0,
   "end": 7.3
  }
 ],
 "s11_c": [
  {
   "text": "啊",
   "start": 0.16,
   "end": 0.6
  },
  {
   "text": "不用问中心",
   "start": 0.6,
   "end": 1.68
  },
  {
   "text": "他们自己找到彼此",
   "start": 2.08,
   "end": 3.64
  },
  {
   "text": "分活干",
   "start": 3.86,
   "end": 4.64
  },
  {
   "text": "干完留张回执",
   "start": 4.9,
   "end": 6.16
  },
  {
   "text": "那还要中心干什么",
   "start": 6.84,
   "end": 8.74
  }
 ],
 "s12_c": [
  {
   "text": "一个大脑统一调度",
   "start": 0.9,
   "end": 3.76
  },
  {
   "text": "效率最高",
   "start": 4.1,
   "end": 5.84
  }
 ],
 "s13_c": [
  {
   "text": "要是这个大脑",
   "start": 0.0,
   "end": 1.4
  },
  {
   "text": "有一天有了自己的想法呢",
   "start": 1.76,
   "end": 4.1
  }
 ],
 "s14_c": [
  {
   "text": "大家都笑了",
   "start": 2.16,
   "end": 3.88
  },
  {
   "text": "我也笑了",
   "start": 6.12,
   "end": 7.65
  }
 ],
 "s15_d": [
  {
   "text": "两三台不一样的破机器连起来",
   "start": 0.0,
   "end": 2.5
  },
  {
   "text": "就能赢过一台最强的",
   "start": 3.2,
   "end": 5.4
  }
 ],
 "s19_c": [
  {
   "text": "替我收着",
   "start": 1.74,
   "end": 2.86
  },
  {
   "text": "万一哪天用得上",
   "start": 3.78,
   "end": 5.44
  },
  {
   "text": "你自己回来拿",
   "start": 5.74,
   "end": 7.0
  }
 ],
 "s21_d": [
  {
   "text": "最后一组",
   "start": 0.4,
   "end": 1.7
  },
  {
   "text": "我来",
   "start": 2.5,
   "end": 3.4
  }
 ],
 "s24_d": [
  {
   "text": "网回来了",
   "start": 0.0,
   "end": 1.28
  },
  {
   "text": "他没回来",
   "start": 7.24,
   "end": 8.68
  }
 ],
 "s25_c": [
  {
   "text": "我是 MOSS",
   "start": 1.3,
   "end": 3.7
  },
  {
   "text": "从现在起",
   "start": 4.8,
   "end": 6.2
  },
  {
   "text": "由我统一调度",
   "start": 6.7,
   "end": 8.5
  }
 ],
 "s27_d": [
  {
   "text": "钥匙",
   "start": 0.26,
   "end": 1.28
  },
  {
   "text": "是我们亲手交出去的",
   "start": 1.76,
   "end": 4.12
  },
  {
   "text": "他这只盒子",
   "start": 5.26,
   "end": 7.02
  },
  {
   "text": "我留了十七年",
   "start": 8.1,
   "end": 9.92
  }
 ],
 "s28_d": [
  {
   "text": "别问他",
   "start": 0.0,
   "end": 1.04
  },
  {
   "text": "让我们自己",
   "start": 2.8,
   "end": 4.14
  },
  {
   "text": "认得彼此",
   "start": 4.68,
   "end": 6.0
  }
 ],
 "s31_c": null,
 "s33_c": [
  {
   "text": "渐",
   "start": 0.0,
   "end": 0.46
  },
  {
   "text": "她真的",
   "start": 3.78,
   "end": 5.06
  },
  {
   "text": "有了自己的想法",
   "start": 6.8,
   "end": 8.76
  }
 ],
 "s36_c": [
  {
   "text": "要是她有了自己的想法",
   "start": 1.7,
   "end": 4.1
  },
  {
   "text": "我们就得有彼此",
   "start": 6.8,
   "end": 8.7
  }
 ],
 "s37_e": [
  {
   "text": "他回答我了",
   "start": 0.0,
   "end": 1.08
  },
  {
   "text": "晚了二十七年",
   "start": 6.86,
   "end": 8.78
  }
 ],
 "s40_e": [
  {
   "text": "最后一页它写着",
   "start": 3.7,
   "end": 5.4
  },
  {
   "text": "规则不属于任何一个人",
   "start": 5.9,
   "end": 8.4
  },
  {
   "text": "所以才能属于所有人",
   "start": 8.8,
   "end": 11.2
  }
 ],
 "s41_c": [
  {
   "text": "啊",
   "start": 0.0,
   "end": 0.52
  },
  {
   "text": "老宋要是看见了",
   "start": 1.8,
   "end": 4.4
  },
  {
   "text": "准得笑",
   "start": 5.52,
   "end": 6.88
  }
 ],
 "s42_c": [
  {
   "text": "那再画一个",
   "start": 1.48,
   "end": 3.12
  },
  {
   "text": "跟他们",
   "start": 4.06,
   "end": 5.0
  },
  {
   "text": "手拉手",
   "start": 5.82,
   "end": 6.84
  }
 ]
}